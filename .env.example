# Database (SQLite for local dev; switch provider to postgresql in prisma/schema.prisma for production)
DATABASE_URL="file:./dev.db"
# Public site URL used for canonical, hreflang and sitemap
NEXT_PUBLIC_SITE_URL="https://askaroamer.com"
# Set to "true" only when real (non-demo) content is live. While false, every page is noindex.
SITE_INDEXABLE="false"
# Payment provider: "test" (built-in sandbox) until Stripe keys are configured
PAYMENT_PROVIDER="test"
# Platform commission in percent on consultations and guides
PLATFORM_FEE_PERCENT="20"
